# SPDX-License-Identifier: GPL-3.0-or-later
# Package an existing Release CMake build configured for /usr.
pkgname=rufus-linux-preview
pkgver=@RUFUS_UPSTREAM_VERSION@.preview@RUFUS_PREVIEW_REVISION@
pkgrel=1
pkgdesc='Rufus Linux preview - create bootable USB drives from disk and ISO images'
arch=('@CMAKE_SYSTEM_PROCESSOR@')
url='https://rufus.ie'
license=('GPL-3.0-or-later')
depends=('qt6-base>=@Qt6Core_VERSION@' 'udisks2' 'polkit' 'util-linux-libs' 'e2fsprogs' '@RUFUS_WIM_NTFS_PROVIDER@' 'hivex' 'openssl' 'zlib' 'libgcc' 'libstdc++' 'glibc' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja')
optdepends=('cdrtools: ISO filesystem export (mkisofs)'
            'dosfstools: FAT16/FAT32 formatting'
            'exfatprogs: exFAT formatting'
            'udftools: UDF data formatting'
            'ntfsprogs-plus: preferred NTFS formatting and optimized FFU resizing'
            'ntfs-3g: compressed or non-512-byte NTFS creation and Windows-compatible symbolic links and FUSE fallback'
            'mtools: Syslinux installation')
options=('!debug')

_build_dir='@CMAKE_CURRENT_BINARY_DIR@'

build() {
    if [[ '@CMAKE_INSTALL_PREFIX@' != /usr || '@BUILD_TESTING@' != OFF || '@CMAKE_BUILD_TYPE@' != Release ]]; then
        error 'Configure a separate Release build with /usr and BUILD_TESTING=OFF first.'
        return 1
    fi
    cmake --build "$_build_dir"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$_build_dir"
}
