#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Runs only as PID 1 in the dedicated, disposable FAT extraction guest.
set -eu
[[ $$ == 1 ]] || exit 77
export PATH=/usr/bin LC_ALL=C
fat_mount_options=utf8=1,shortname=mixed

finish()
{
    result=$?
    trap - EXIT
    echo "RUFUS_FAT_EXIT $result"
    echo o > /proc/sysrq-trigger
    while :; do sleep 1; done
}

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
[[ $(< /sys/class/dmi/id/product_name) == RufusFATExtractFixture ]]
[[ " $(< /proc/cmdline) " == *" rufus.fat_fixture=1 "* ]]
trap finish EXIT
trap 'echo "RUFUS_FAT_FAILED_AT_LINE $LINENO"' ERR
for module in xhci_pci usb_storage sd_mod vfat nls_cp437 nls_iso8859_1; do
    modprobe "$module"
done
for attempt in {1..100}; do
    [[ -b /dev/sda1 ]] && break
    sleep .1
done
[[ -b /dev/sda1 ]]
[[ $(< /sys/block/sda/device/model) == "QEMU HARDDISK "* ]]
mount -t vfat -o "$fat_mount_options" /dev/sda1 /target
echo RUFUS_FAT_MOUNTED

extract_case()
{
    local name=$1 image=$2 view=$3 fault=$4
    echo "RUFUS_FAT_CASE $name"
    iso_extract_probe "/images/$image.iso" "/target/$name" "$view" "$fault" "${@:5}"
    echo "RUFUS_FAT_END $name"
}

for name in rr joliet udf names-rr names-udf merge-rr merge-udf collision replace-zero invalid \
    write-fail cancel sync-fail full readonly recovery config-keep config-backup config-conflict config-patch \
    label-patch repo-patch netinst-patch invalid-patch freenas efi-copy efi-keep efi-failed-copy; do
    mkdir "/target/$name"
done
extract_case rr TREE rr none
extract_case joliet TREE joliet none
extract_case udf UDF rr none
extract_case names-rr NAMEDRR rr none
extract_case names-udf NAMEDUDF rr none
extract_case merge-rr MERGEDRR rr none
extract_case merge-udf MERGEDUDF rr none
extract_case collision COLLISION rr none
extract_case replace-zero ZERO rr collision
extract_case invalid INVALID rr none
extract_case write-fail DATA rr write-fail
extract_case cancel DATA rr write-cancel
extract_case sync-fail DATA rr sync-fail
extract_case config-keep CONFIGKEEP rr none
extract_case config-backup CONFIGBACKUP rr none
extract_case config-conflict CONFIGCONFLICT rr none
extract_case config-patch CONFIGPATCH rr none
extract_case label-patch 'OLD LABEL' rr none 'NEW USB' /original/dvd.iso
extract_case repo-patch RHEL-9 rr none 'NEW USB' /original/dvd.iso
extract_case netinst-patch RHEL-9 rr none 'NEW USB' /original/netinst.iso
extract_case invalid-patch BADCONFIG rr none 'NEW USB' /original/dvd.iso
extract_case freenas FREENAS rr none 'NEW USB' /original/dvd.iso
extract_case efi-copy EFICONFIG rr none 'NEW USB' /original/dvd.iso
extract_case efi-keep EFIKEEP rr none
extract_case efi-failed-copy EFICONFIG rr duplicate-write-fail 'NEW USB' /original/dvd.iso

patch_config_case()
{
    local name=$1 source=$2 replacement=$3
    echo "RUFUS_CONFIG_PATCH $name"
    config_patch_probe /target/config-patch "$name" append "$source" "$replacement"
    echo RUFUS_CONFIG_END
}
patch_config_case boot.cfg 'OLD\x20LABEL' 'NEW\x20USB'
patch_config_case unicode.cfg OLD NEW
patch_config_case keep.cfg OLD NEW
patch_config_case invalid.cfg OLD NEW

# Leave half a MiB available: the real FAT driver must accept some data before
# ENOSPC. The extractor must remove that partial file and retain no descriptor.
dd if=/dev/zero of=/target/reserve.bin bs=512K count=1 status=none
if dd if=/dev/zero of=/target/fill.bin bs=1M status=none; then
    exit 1
fi
rm /target/reserve.bin
extract_case full DATA rr none
rm /target/fill.bin
umount /target

mount -t vfat -o "ro,$fat_mount_options" /dev/sda1 /target
extract_case readonly DATA rr none
umount /target
mount -t vfat -o "$fat_mount_options" /dev/sda1 /target
extract_case recovery TREE rr none
umount /target
echo RUFUS_FAT_UNMOUNTED
